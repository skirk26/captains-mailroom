# Copy to .env and fill in. .env is git-ignored; never commit real values.

# "production" (the default if unset) or "development".
# production: Secure cookies and HTTPS-only (HSTS), and the app refuses to start
#   unless SECRET_KEY below is set to a real value.
# development: for local testing over plain HTTP; uses a built-in key if
#   SECRET_KEY is unset. Never use development on a real server.
APP_ENV=development

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 1 turns on Flask's debug mode (auto-reload and the in-browser debugger).
# Default 0. Never set to 1 on a real server: the debugger can run code.
FLASK_DEBUG=0
