# Copy to .env and fill in. .env is git-ignored; never commit real values.

# "production" (the default if unset) or "development".
# production: Secure cookies and HTTPS-only (HSTS), and the app refuses to start
#   unless SECRET_KEY below is set to a real value.
# development: for local testing over plain HTTP; uses a built-in key if
#   SECRET_KEY is unset. Never use development on a real server.
APP_ENV=development

# The mailroom's time zone (an IANA name). The home screen's "Today" counts
# start at midnight here. Default America/New_York.
APP_TIMEZONE=America/New_York

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 1 turns on Flask's debug mode (auto-reload and the in-browser debugger).
# Default 0. Never set to 1 on a real server: the debugger can run code.
FLASK_DEBUG=0

# Set to 1 when the host terminates HTTPS and forwards requests to the app, as
# PythonAnywhere does. The app then reads the real client address and the https
# scheme from the proxy's X-Forwarded-* headers. Without it every user looks
# like one IP address, so the sign-in limit (5 a minute) would be shared by all
# staff. Default 0. Leave it 0 when nothing is in front of the app: anyone could
# then fake those headers.
TRUST_PROXY=0
